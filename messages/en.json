  "IsThisForYouSection": {
    "title": "You may have arrived here because...",
    "intro": {
      "paragraph1": "You've tried to find solutions on your own. You've read articles, followed advice found online, tested approaches \"that work for everyone\"... except for you.",
      "paragraph2": "You're tired of not understanding what's happening in your body. Tired of receiving generic advice that doesn't take YOUR reality into account. Tired of feeling alone with your symptoms.",
      "ifYouLive": "If you're experiencing any of these situations, I can really help you:"
    },
    "situations": {
      "menopause": {
        "title": "Relief from menopause symptoms",
        "description": "Hot flashes, sleep disorders, weight gain, mood swings... Menopause disrupts your body, but you don't have to suffer. Nutrition can really help you."
      },
      "weightLoss": {
        "title": "Weight loss without restrictive diets",
        "description": "You're tired of yo-yo diets that never work long-term. You deserve a sustainable approach, without deprivation, that respects your body and your life."
      },
      "digestive": {
        "title": "Soothe your digestive discomfort",
        "description": "Bloating, reflux, irritable bowel syndrome, food sensitivities... Your stomach is making you suffer and you no longer know what to eat. There are concrete solutions."
      },
      "glycemia": {
        "title": "Stabilize your blood sugar or blood pressure",
        "description": "Prediabetes, type 2 diabetes, hypertension... Your doctor tells you to \"be careful\" but no one explains how. I translate medical advice into concrete actions."
      },
      "cardiovascular": {
        "title": "Improve your cardiovascular health",
        "description": "High cholesterol, triglycerides, heart disease prevention... You want to protect your heart naturally, through nutrition. It's possible."
      },
      "energy": {
        "title": "Regain your energy and vitality",
        "description": "Chronic fatigue, repeated energy crashes, feeling like you're running in slow motion... Your body needs to be nourished differently to regain its energy."
      },
      "longevity": {
        "title": "Invest in your longevity and well-being",
        "description": "No urgent problem, but you feel it's time to invest in your health. Prevent, optimize, age in great shape... It's happening now."
      }
    },
    "recognition": "Do you recognize yourself in one or more of these situations?",
    "accompaniment": "I'm here to support you, with kindness and expertise, towards sustainable well-being.",
    "cta": "Book my discovery consultation",
    "microReassurance": "1h30 to discuss YOUR situation • No commitment"
  },
